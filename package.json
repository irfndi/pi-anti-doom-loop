{
  "name": "pi-anti-doom-loop",
  "version": "0.0.14",
  "description": "Detect and break agent doom loops in pi: blocks identical repeated tool calls and blind retries before they burn tokens.",
  "keywords": [
    "anti-doom-loop",
    "loop-detection",
    "pi-extension",
    "pi-package"
  ],
  "homepage": "https://github.com/irfndi/pi-anti-doom-loop",
  "license": "MIT",
  "author": "irfandi <join.mantap@gmail.com> (https://github.com/irfndi)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/irfndi/pi-anti-doom-loop.git"
  },
  "files": [
    "extensions",
    "scripts",
    "CHANGELOG.md"
  ],
  "type": "module",
  "main": "extensions/index.ts",
  "types": "extensions/index.ts",
  "exports": {
    ".": "./extensions/index.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "pnpm run test && tsc --noEmit && oxlint --deny-warnings && oxfmt --check .",
    "prepublishOnly": "pnpm run check",
    "test": "node --test tests/*.test.ts tests/e2e/*.test.ts",
    "guard": "node scripts/guard-publish.ts",
    "e2e:pi": "node --test tests/e2e/pi.test.ts",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "prepare": "effect-tsgo patch --no-typescript --oxlint --skip-missing"
  },
  "dependencies": {
    "@effect/tsgo": "0.56.1",
    "better-result": "^3.0.0",
    "effect": "^4.0.0-rc.108"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@oxlint/plugins": "1.89.0",
    "@types/node": "^22.0.0",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@12.8.1",
  "pi": {
    "extensions": [
      "./extensions"
    ]
  }
}
